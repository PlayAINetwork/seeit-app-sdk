# Port the Express server listens on (serves the webview + API + webhook + audio).
PORT=5004

# Your app's ID from the SeeIt developer console. Tokens must carry this as
# their `aud`, so verification rejects tokens minted for any other app.
SEEIT_APP_ID=00000000-0000-0000-0000-000000000000

# Where to fetch SeeIt's public keys to verify launch/session tokens.
#   local dev: http://localhost:3000/glass/.well-known/jwks.json
SEEIT_JWKS_URL=http://localhost:3000/glass/.well-known/jwks.json

# Public base URL the GLASSES can reach to fetch the soundscape audio files.
# session.audio.playAudio() hands this URL to the device, so it must be publicly
# reachable (not localhost). In production set it to your deployed origin; for
# local testing use your tunnel URL (e.g. https://abc123.ngrok.app).
PUBLIC_BASE_URL=

# Required. The signing secret SeeIt issued for this app (whsec_...), shown once
# at registration. Every webhook is signed; without this the server refuses to
# start, and the endpoint could never pass the ownership handshake.
WEBHOOK_SECRET=
